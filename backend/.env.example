# Copy this file to .env and fill in the values.

# Required. Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional. One-click demo login for the seeded demo accounts only.
# Leave false unless you are giving a demo; run `python seed.py --demo` first.
DEMO_MODE=false

# Optional. Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Defaults to a SQLite file next to this one.
# DATABASE_URL=sqlite:///./mathverse.db

# Optional. Lets an AI model rephrase Gwen's hints in character. Without it the
# game uses the built-in hints and works exactly the same.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Turns on "Sign in with Google". The OAuth client ID from Google Cloud
# Console (APIs & Services > Credentials), with http://localhost:5173 added as an
# authorised JavaScript origin. It is not a secret. Without it the button is hidden.
GOOGLE_CLIENT_ID=
