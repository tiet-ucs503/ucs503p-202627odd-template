# Server
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Use a session-mode connection for DATABASE_URL so Prisma interactive
# transactions (order inventory) work. Transaction-mode PgBouncer (port 6543)
# can break those writes.
# If `prisma migrate deploy` fails on DIRECT_URL (port 5432 unreachable), use the
# Session pooler host for DIRECT_URL too, or run: npm run prisma:deploy:pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase Storage (server only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_LISTINGS_BUCKET=listings

# JWT (use different random values of at least 64 characters)
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_64_characters_long_1234
JWT_REFRESH_SECRET=replace_with_a_different_refresh_secret_at_least_64_characters_123
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (64 hexadecimal characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin seed
ADMIN_SEED_EMAIL=admin@agriconnect.local
ADMIN_SEED_PASSWORD=replace_with_a_strong_password

# Demo marketplace data for faculty demos (npm run prisma:seed)
SEED_DEMO=true
DEMO_USER_PASSWORD=Demo@AgriConnect1

# Optional email configuration (console fallback in local development)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@agriconnect.local

# Optional monitoring
SENTRY_DSN=

# Optional — Google AI Studio key for Kisan (farmer mascot chatbot)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Pin a TTS model for fastest read-aloud (skips probing other TTS models).
# Recommended: gemini-3.1-flash-tts-preview (fast) or gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Reasoning effort for Kisan replies: minimal | low | medium | high.
# Gemini 3 bills thinking tokens against the output budget, so `minimal` keeps
# replies fast and complete. Raise to `low` for more reasoning per answer.
GEMINI_THINKING_LEVEL=minimal

# Optional — seed a human AGRONOMIST for Grounded Kisan escalations (not self-registerable).
# Defaults match prisma/seed.ts when blank.
AGRONOMIST_SEED_EMAIL=agronomist@demo.agriconnect.local
AGRONOMIST_SEED_PASSWORD=Demo@AgriConnect1

# Optional — OpenWeatherMap key for live weather snippets in grounded crop/weather answers.
# Without it, Kisan still uses curated weather rules from the knowledge pack.
OPENWEATHER_API_KEY=

# Optional — Razorpay sandbox for escrow-style payments (V2).
# Leave blank to run payments in simulated ("mock") mode. Cash on delivery never
# touches the gateway, so it works with or without these keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — webhook secret from Razorpay Dashboard → Settings → Webhooks.
# Point the webhook at POST /api/v1/payments/webhook and subscribe to
# payment.captured + payment.failed. Blank disables the webhook (503).
RAZORPAY_WEBHOOK_SECRET=

# Optional — STUN/TURN servers for in-app voice calls (comma-separated).
# Defaults to public Google STUN. Add a TURN server for calls behind strict NATs.
WEBRTC_ICE_SERVERS=

# Govt mandi prices (Agmarknet / data.gov.in)
MANDI_API_BASE_URL=https://mandi-api.onrender.com
MANDI_SYNC_ENABLED=true
# Recommended for production — free key from https://data.gov.in (all states, higher reliability than free mandi-api)
DATA_GOV_IN_API_KEY=
