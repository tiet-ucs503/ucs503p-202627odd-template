{
  "name": "weightlifting-form-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered webcam squat form-analysis system (V1). React + MediaPipe (client-side) + FastAPI + SQLite.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "./start.sh",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "test:frontend": "npm --workspace frontend run test",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "test:backend": "cd backend && pytest -q"
  },
  "license": "MIT"
}
