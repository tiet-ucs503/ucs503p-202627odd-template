# Copy this file to `.env.local` and fill in the values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# `.env.local` is git-ignored; never commit real keys.

# --- Firebase web app config (safe to expose to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local development ---
# Set to "true" to point the app at the local Firebase Emulator Suite
# (`npm run emulators`) instead of the real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# --- Trip generation ---
# The itinerary generator (src/lib/services/itinerary-generator.ts) is
# deterministic and needs no key of its own: it turns a city plan into days,
# asking the places provider below for each city's content and the
# feasibility engine (src/lib/services/feasibility/) whether the result fits
# in a day. Which cities to visit is decided separately — see the AI city
# planner section below. Travel times are estimated locally; no routing or
# directions API is called anywhere in the app, so there is nothing to
# configure for that either.

# --- Places (REQUIRED to plan a trip) ---
# Every hotel, sight, restaurant and nightlife recommendation, the "replace with a
# real place" search and place photos come from Google Places (API "Places API
# (New)"), through src/lib/services/places/. TripEase has no built-in sample
# places: without this key it tells the traveller that place search isn't set up,
# instead of building a trip out of made-up ones. Places are chosen by their real
# Google Maps ratings and review counts.
#
# This key is SERVER-ONLY: do not rename it with a NEXT_PUBLIC_ prefix, or it
# will be bundled into the browser and exposed to every visitor. It is only ever
# read in src/lib/services/places/index.ts and the server-side routes that use it.
#
# NOTE: the interactive map needs no key at all (OpenStreetMap tiles).
GOOGLE_PLACES_API_KEY=

# --- AI (optional) ---
# Decides which cities a trip visits and for how long, powers Travis, and
# changes a trip when asked. There is no stand-in model: without a key Travis says
# he is unavailable, and the city split uses the rule-based planner (real cities
# from the country list), so a trip can still be planned.
#
# AI_PROVIDER=groq     live, via Groq (needs GROQ_API_KEY)
# AI_PROVIDER=gemini   live, via Gemini (needs GEMINI_API_KEY)
# unset / none         rule-based city planner, Travis unavailable
#
# SERVER-ONLY. Never rename GROQ_API_KEY with a NEXT_PUBLIC_ prefix, which
# would bundle it into the browser and expose it to every visitor.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Photo URL signing (optional) ---
# /api/places/photo is loaded by <img>, which can't send an auth header, so
# photo links are HMAC-signed instead. If unset, a signing secret is derived
# from GOOGLE_PLACES_API_KEY; set this explicitly to rotate photo links
# independently of the Places key.
# PHOTO_URL_SECRET=

# --- Gemini (optional) ---
# An alternative to Groq. Set AI_PROVIDER=gemini and put a Gemini API key
# below (Google AI Studio, or the Gemini API in Google Cloud). SERVER-ONLY:
# never give it a NEXT_PUBLIC_ prefix, which would publish it to every visitor.
# GEMINI_MODEL is optional; the default is a fast, inexpensive model.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Trip agent (optional) ---
# The assistant on a trip's page that changes the trip when asked. By default it
# uses AI_PROVIDER like everything else. To give it a different model from the
# city planner and Travis (for example Gemini for editing), set this to
# groq or gemini. Leave it empty to inherit AI_PROVIDER.
TRIP_AGENT_PROVIDER=
