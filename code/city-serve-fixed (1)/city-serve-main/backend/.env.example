# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---- Database (MySQL, via Sequelize + mysql2) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cityserve
DB_USER=root
DB_PASSWORD=ruhanika@1205

# ---- Auth ----
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Maps (Mapbox) ----
# If unset, the frontend automatically falls back to DEMO MODE (no live map/geocoding).
MAPBOX_ACCESS_TOKEN=

# ---- Payments (Razorpay) ----
# If unset, checkout automatically falls back to DEMO MODE (simulated payment, clearly labeled).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- File storage (Cloudinary) ----
# If unset, file upload endpoints are disabled and return a clear error.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
